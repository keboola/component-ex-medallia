    "config": {
      "action": "run",
      "parameters": {
        "api_host": "PLACEHOLDER_API_HOST",
        "company_name": "DUMMY_COMPANY",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_CLIENT_SECRET",
        "data_object": "feedback",
        "fields": ["e_nps"],
        "survey_id_field_id": "a_surveyid",
        "load_type": "incremental_load"
      }
    }
  }
