  {
    "name": "12_feedback",
    "description": "feedback (shape a, fieldData, node-id PK) incremental on the epoch finish field, bounded by a Start Date (epoch 1781542800) and a day-granular End Date (epoch 1781550000, floored to its day and made inclusive, so the effective upper bound is the following midnight) to keep the recording small and deterministic.",
    "config": {
      "action": "run",
      "parameters": {
        "instance_host": "example.medallia.com",
        "api_host": "example.apis.medallia.com",
        "company_name": "example",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_CLIENT_SECRET",
        "mode": "structured",
        "data_object": "feedback",
        "page_size": 25,
        "load_type": "incremental_load",
        "fields": [
          "a_customerid",
          "e_accepteddate"
        ],
        "incremental_field": "a_initial_finish_timestamp",
        "initial_start": "1781542800",
        "end_date": "1781550000"
      }
    }
  },
  {
