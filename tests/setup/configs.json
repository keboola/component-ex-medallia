  {
    "name": "03_feedback_incremental",
    "description": "Small feedback extract. RECORDING MUST USE page_size=5 and a narrow initial_start_epoch (~7 days) to keep the live blast radius tiny (see tests/README.md).",
    "config": {
      "action": "run",
      "parameters": {
        "instance_host": "PLACEHOLDER_INSTANCE_HOST",
        "api_host": "PLACEHOLDER_API_HOST",
        "company_name": "DUMMY_COMPANY",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_CLIENT_SECRET",
        "data_object": "feedback",
        "fields": ["e_nps", "e_comment"],
        "finish_date_field_id": "k_initialfinishdate_epoch_int",
        "survey_id_field_id": "a_surveyid",
        "page_size": 5,
        "initial_start_epoch": 1751500800,
        "load_type": "incremental_load"
      }
    }
  },
  {
    "name": "10_run_invalid_config",
