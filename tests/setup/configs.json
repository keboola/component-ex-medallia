  {
    "name": "15_raw",
    "description": "raw mode - user Relay query paginated via $first/$after; full load, no state. Bounded by an in-query epoch filter (same 2h window) so pagination terminates quickly on a small slice.",
    "config": {
      "action": "run",
      "parameters": {
        "instance_host": "example.medallia.com",
        "api_host": "example.apis.medallia.com",
        "company_name": "example",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_CLIENT_SECRET",
        "mode": "raw",
        "output_table": "raw_feedback",
        "page_size": 25,
        "raw_query": "query ($first: Int!, $after: ID) { feedback(first: $first, after: $after, filter: {fieldIds: [\"a_initial_finish_timestamp\"], gte: \"1781542800\", lt: \"1781550000\"}) { nodes { id a_customerid: fieldData(fieldId: \"a_customerid\") { values } } pageInfo { hasNextPage endCursor } } }"
      }
    }
